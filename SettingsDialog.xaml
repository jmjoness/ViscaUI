<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
	x:Class="ViscaUI.SettingsDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:ViscaUI"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<StackPanel Orientation="Vertical">
		<StackPanel Orientation="Horizontal">
			<TextBox IsReadOnly="True" Text="Port" />
			<ComboBox x:Name="portCombo" SelectionChanged="portCombo_SelectionChanged"></ComboBox>
		</StackPanel>
		<StackPanel Orientation="Horizontal">
			<TextBox IsReadOnly="True" Text="Speed" />
			<ComboBox x:Name="speedCombo" SelectionChanged="speedCombo_SelectionChanged"></ComboBox>
		</StackPanel>
		<!--<StackPanel Orientation="Horizontal">
			<TextBox IsReadOnly="True" Text="Mode" />
			<ComboBox x:Name="modeCombo" SelectionChanged="modeCombo_SelectionChanged"></ComboBox>
		</StackPanel>-->
		<StackPanel Orientation="Horizontal">
			<CheckBox x:Name="miniCheck" Content="Mini Disp" Checked="miniCheck_Checked" Unchecked="miniCheck_Unchecked"/>
			<CheckBox x:Name="commsCheck" Content="Show Comms" Checked="commsCheck_Checked" Unchecked="commsCheck_Unchecked"/>
			<CheckBox x:Name="logCheck" Content="Keep Log" Checked="logCheck_Checked" Unchecked="logCheck_Unchecked"/>
		</StackPanel>
	</StackPanel>
</ContentDialog>
